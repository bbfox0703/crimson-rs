/target
__pycache__
tmp
python/**/*.so
python/**/*.pyd
python/**/*.pdb
/.venv/

# ── Generated output (contains extracted game data — do NOT commit) ──
# All files in out/ are derived from the user's local Crimson Desert install:
#   iteminfo.pabgb       raw decompressed binary from group 0008
#   items.jsonl          parsed view of the same binary
#   items_skipped.json   diagnostic, lossy-mode only
#   anchors.json         per-item file offset table
#   unknown_items.json   diagnostic
#   paloc_*.json         translation tables extracted from groups 0019-0035
#   output*.txt          CE dropdown lists derived from the above
# These are copyrighted Pearl Abyss content; keep them local.
/out/

# Game-data samples kept locally for parser work (e.g. iteminfo_1.05.pabgb)
/references/samples/

# Locally installed historical parser wheel (e.g. commit 56a57da's 1.04 build)
# used by RE scripts for cross-version field-offset comparisons.
/.crimson_rs_104/

# Per-developer Claude Code settings (plugins, hooks, slash commands).
# Personal preferences — not project content.
/.claude/

# Raw process-memory dumps used for RE diagnostics (e.g. CE "Save Memory Region"
# of the in-game itemKey array). Keep them on disk for current-session use,
# but never commit — they reveal game-side memory layout.
*.CEM

# git-crypt symmetric key: NEVER commit it. The live key lives in
# .git/git-crypt/ (which git already never tracks) and is exported OUTSIDE
# the repo. This guard catches a key file accidentally copied into the tree.
# (The encrypted *.save fixtures themselves are committed — see .gitattributes.)
*.key
/.git-crypt/
